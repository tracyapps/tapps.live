# ── tapps.live environment ─────────────────────────────────────────────
# Copy to .env and fill in. Everything is optional except admin access —
# the site runs with all feeds in "not configured" until keys are added
# in the admin console (Admin → Feeds), which is the preferred place.

# Admin login for /admin (required to use the CMS)
ADMIN_PASSWORD=change-me-please

# Secret used to sign session cookies (any long random string)
SESSION_SECRET=some-long-random-string-here

# ── Feed keys ──────────────────────────────────────────────────────────
# These can also be set per-feed in Admin → Feeds. Env wins if both exist.

# GitHub: optional PAT raises the rate limit (public data works without)
GITHUB_TOKEN=

# Twitch: https://dev.twitch.tv/console — app client id + secret
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_LOGIN=tracyapps

# last.fm: https://www.last.fm/api/account/create (just needs an API key)
LASTFM_API_KEY=
LASTFM_USER=tracyapps

# YouTube: channel id (UC...) for the public channel RSS feed
YOUTUBE_CHANNEL_ID=

# Art: WordPress RSS feed from artbytapps.com
ART_FEED_URL=https://artbytapps.com/feed/
